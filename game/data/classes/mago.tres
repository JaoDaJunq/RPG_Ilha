[gd_resource type="Resource" script_class="ClasseData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/classe_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/habilidade_data.gd" id="2_hab_script"]
[ext_resource type="Resource" path="res://data/habilidades/bola_de_fogo.tres" id="3_hab1"]
[ext_resource type="Resource" path="res://data/habilidades/lanca_gelo.tres" id="4_hab2"]

[resource]
script = ExtResource("1_script")
id = &"mago"
nome = "Mago"
familia = "Arcana"
descricao = "Fogo, gelo e raio: dano de longe e controle."
atributos = Dictionary[StringName, int]({&"forca": 3, &"vitalidade": 4, &"agilidade": 5, &"intelecto": 8, &"espirito": 5})
habilidades = Array[ExtResource("2_hab_script")]([ExtResource("3_hab1"), ExtResource("4_hab2")])
ramo_a = "Elementos"
ramo_b = "Invocação"
