[gd_resource type="Resource" script_class="ClasseData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/classe_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/data/habilidade_data.gd" id="2_hab_script"]
[ext_resource type="Resource" path="res://data/habilidades/cura.tres" id="3_hab"]
[ext_resource type="Resource" path="res://data/habilidades/escudo_sagrado.tres" id="4_hab"]
[ext_resource type="Resource" path="res://data/habilidades/luz_sagrada.tres" id="5_hab"]
[ext_resource type="Resource" path="res://data/habilidades/bencao.tres" id="6_hab"]

[resource]
script = ExtResource("1_script")
id = &"clerigo"
nome = "Clérigo"
familia = "Sagrada"
descricao = "Apoio do grupo: cura, protege e queima o que a luz alcança."
atributos = Dictionary[StringName, int]({&"forca": 4, &"vitalidade": 6, &"agilidade": 3, &"intelecto": 4, &"espirito": 8})
habilidades = Array[ExtResource("2_hab_script")]([ExtResource("3_hab"), ExtResource("4_hab"), ExtResource("5_hab"), ExtResource("6_hab")])
ramo_a = "Curandeiro"
ramo_b = "Protetor"
